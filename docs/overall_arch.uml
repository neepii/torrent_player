@startuml
allowmixing

title Torrent Player Diagram

class TorrentData {
  + string announce_url
  + string comment
  + timestamp creation_date
  + TorrentInfoDict info_dict
}

class TorrentInfoDict {
  + int info_length
  + string name
  + int piece_length
  + byte[] piece_hashes (SHA-1)
}

class PeerData {
  + IP ip
  + short port
}

class PeerConnection {
  + PeerData ptr_to_data
  + int tcp_socket
}

class DataStream {
  + int unix_ipc_socket
  + byte[] fMP4 data (H.264)
}

actor Tracker
actor Peer
actor FFmpeg

file ".torrent" as TorrentFile
rectangle "Bencoding parser" as BencodeParser
rectangle "Core" as Core
rectangle "SHA-1 checksum" as Checksum
rectangle "MP4 → fMP4 remux (mp4ff)" as Remux
TorrentFile --> BencodeParser

TorrentInfoDict -u-> TorrentData

BencodeParser --> TorrentData

TorrentData -> Tracker: GET Request
Tracker -> PeerData: Peers IP's

PeerConnection -> Peer
DataStream --> FFmpeg


PeerData --> Core

Core --> Remux: sequential mp4 bytes (verified pieces)
Remux --> DataStream: fMP4 fragments
Core --> PeerConnection: Request piece
Checksum <-- PeerConnection: piece data
Core <- Checksum: verified piece
TorrentInfoDict <- Core: Get hashes

@enduml